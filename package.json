{
  "name": "@sphyra/react-native",
  "version": "0.1.0",
  "description": "React Native SDK for the Sphyra map & geocoding API",
  "license": "UNLICENSED",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@maplibre/maplibre-react-native": "^10.0.0",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@maplibre/maplibre-react-native": "^10.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "typescript": "^5.9.0",
    "vitest": "^2.1.5"
  }
}
